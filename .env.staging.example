# ==============================================================================
# ŞehirNabız — Staging Ortamı Çevresel Değişken Şablonu (.env.staging.example)
# ==============================================================================
# UYARI: Bu dosya yalnızca staging altyapısı için şablondur.
# Gerçek üretim (production) veya hassas staging şifrelerini asla bu dosyaya yazmayınız.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Genel Uygulama & Ortam Ayarları
# ------------------------------------------------------------------------------
NODE_ENV=staging
PORT=3000
API_PREFIX=api/v1
PUBLIC_URL=https://staging-api.sehirnabiz.local

# ------------------------------------------------------------------------------
# 2. Güvenlik, Oturum & JWT Yapılandırması (HS256 / RS256 - Min 32 Karakter)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_STAGING_SUPER_SECRET_ACCESS_KEY_32CHARS_MIN!
JWT_REFRESH_SECRET=CHANGE_ME_STAGING_SUPER_SECRET_REFRESH_KEY_32CHARS_MIN!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=CHANGE_ME_STAGING_COOKIE_SECRET_32CHARS_MIN!

# ------------------------------------------------------------------------------
# 3. PostgreSQL 16 + PostGIS Veritabanı
# ------------------------------------------------------------------------------
DB_HOST=staging-postgres
DB_PORT=5432
DB_USERNAME=sehir_nabiz_staging_user
DB_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD
DB_DATABASE=sehir_nabiz_staging
DB_SYNCHRONIZE=false
DB_LOGGING=false
DATABASE_URL=postgres://sehir_nabiz_staging_user:CHANGE_ME_STAGING_DB_PASSWORD@staging-postgres:5432/sehir_nabiz_staging

# ------------------------------------------------------------------------------
# 4. Redis 7 (Önbellek, WebSocket Dağıtımı & Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_HOST=staging-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STAGING_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STAGING_REDIS_PASSWORD@staging-redis:6379/0

# ------------------------------------------------------------------------------
# 5. S3 / MinIO Uyumlu Nesne Depolama
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=http://staging-minio:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=staging_minio_admin
STORAGE_SECRET_KEY=CHANGE_ME_STAGING_MINIO_SECRET_KEY
STORAGE_BUCKET=sehir-nabiz-media-staging
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_URL=https://staging-media.sehirnabiz.local/sehir-nabiz-media-staging

# ------------------------------------------------------------------------------
# 6. Ağ Güvenliği, CORS & Trusted Proxy (Nginx Entegrasyonu)
# ------------------------------------------------------------------------------
# İzin verilen web ve mobil staging orijinleri (virgülle ayrılmış)
CORS_ORIGIN=https://staging.sehirnabiz.local,https://staging-portal.sehirnabiz.local,http://localhost:8081
# WebSocket bağlantı orijinleri
WEBSOCKET_CORS_ORIGIN=https://staging.sehirnabiz.local,https://staging-portal.sehirnabiz.local
# Ters vekil (reverse proxy) arkasında güvenilen IP blokları (Docker dahili bridge ağı)
TRUSTED_PROXY_IPS=127.0.0.1,172.16.0.0/12,10.0.0.0/8

# ------------------------------------------------------------------------------
# 7. Hız Sınırlama (Rate Limiting)
# ------------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=60
AUTH_THROTTLE_LIMIT=10

# ------------------------------------------------------------------------------
# 8. Push Bildirimleri (Staging / Mock Modu)
# ------------------------------------------------------------------------------
# Staging ortamında gerçek bildirim maliyeti yaratmamak için mock adaptörü etkin tutulabilir
PUSH_ADAPTER_MODE=dev_adapter
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
