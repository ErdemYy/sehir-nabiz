{
  "name": "sehir-nabiz-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "ŞehirNabız — Türkiye Kentsel Olay ve Gelişme Takip Platformu Monorepo",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
