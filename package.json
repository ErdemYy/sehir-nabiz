    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "mobile": "pnpm --filter sehir-nabiz-mobile",
    "api": "pnpm --filter sehir-nabiz-api"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.11.10",
    "typescript": "^5.8.2"
