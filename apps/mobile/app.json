{
  "expo": {
    "name": "ŞehirNabız",
    "slug": "sehir-nabiz",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sehirnabiz",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#14B8A6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sehirnabiz.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#14B8A6"
      },
      "package": "com.sehirnabiz.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
