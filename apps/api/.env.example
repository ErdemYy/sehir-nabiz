# ŞehirNabız Backend Çevresel Değişkenleri (Environment Variables)
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
CORS_ORIGIN=*

# PostgreSQL & PostGIS (Phase 2'de aktif edilecek)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sehir_nabiz?schema=public

# Redis (Phase 2'de aktif edilecek)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Gizli Anahtarları (Phase 2'de aktif edilecek)
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRATION=7d
