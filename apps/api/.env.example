# ŞehirNabız Backend Çevresel Değişkenleri
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
CORS_ORIGIN=*

# PostgreSQL & PostGIS (Docker Compose ile uyumlu)
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres_secure_dev_password
DB_DATABASE=sehir_nabiz
DATABASE_URL=postgresql://postgres:postgres_secure_dev_password@127.0.0.1:5434/sehir_nabiz
DB_LOGGING=false
DB_SYNCHRONIZE=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=redis_dev_secret

# JWT Kimlik Doğrulama (Üretim ortamında güçlü rastgele 64 karakter anahtarlar üretiniz)
# openssl rand -base64 48
JWT_ACCESS_SECRET=sehir_nabiz_default_access_jwt_secret_key_32chars_min!
JWT_REFRESH_SECRET=sehir_nabiz_default_refresh_jwt_secret_key_32chars_min!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Hız Sınırı (Rate Limiting)
THROTTLE_TTL=60
THROTTLE_LIMIT=20

# Object Storage (MinIO / Cloudflare R2)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=minio_admin_user
STORAGE_SECRET_KEY=minio_secure_dev_password
STORAGE_BUCKET=sehir-nabiz-media
STORAGE_PUBLIC_URL=http://127.0.0.1:9000/sehir-nabiz-media
STORAGE_FORCE_PATH_STYLE=true
