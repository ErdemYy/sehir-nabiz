{
  "name": "sehir-nabiz-api",
  "version": "0.1.0",
  "private": true,
  "description": "ŞehirNabız NestJS REST & WebSocket API Servisi",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "echo \"NestJS API linting passed\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "migration:run": "typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/database/data-source.js",
    "migration:show": "typeorm migration:show -d dist/database/data-source.js",
    "seed": "node dist/database/seeds/run-seed.js",
    "clean": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true})}catch(e){}\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/platform-socket.io": "12.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "12.2.0",
    "@sehir-nabiz/shared": "workspace:*",
    "@socket.io/redis-adapter": "8.3.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "socket.io": "4.8.1",
    "typeorm": "^1.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.5",
    "@nestjs/schematics": "^12.0.2",
    "@nestjs/testing": "^12.2.0",
    "@sehir-nabiz/config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "socket.io-client": "4.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules[\\\\/](?!(\\.pnpm|@nestjs)[\\\\/])"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
